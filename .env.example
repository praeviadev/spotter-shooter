APP_HOST=spotter.praeviaintel.com
POSTGRES_DB=spotter
POSTGRES_USER=spotter
POSTGRES_PASSWORD=spotter-local-dev
DATABASE_URL=postgresql://spotter:spotter-local-dev@postgres:5432/spotter
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=spotter
MINIO_ROOT_PASSWORD=spotter-minio-local
# Set this to your own Elastic endpoint. Do not point public deployments at a shared private lab.
ELASTICSEARCH_URL=http://host.docker.internal:9209
ADMIN_USERNAME=admin
ADMIN_PASSWORD=spotter-admin-local
# 2FA delivery webhooks. If unset, local/demo mode displays the one-time code in the UI.
# Both endpoints should accept JSON POST. Email receives: {"to","subject","text"}. SMS receives: {"to","message"}.
SMTP_URL=
SMS_WEBHOOK_URL=
APP_SECRET=change-me-long-random-secret
